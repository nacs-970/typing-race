{
  "name": "typing-race",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"bun --filter @typing-race/server run dev\" \"bun --filter @typing-race/web run dev\"",
    "dev:server": "bun --filter @typing-race/server run dev",
    "dev:web": "bun --filter @typing-race/web run dev",
    "typecheck": "bun --filter '*' run typecheck",
    "build": "bun --filter @typing-race/web run build",
    "start": "bun --filter @typing-race/server run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.3.2 <1.5.0"
  },
  "packageManager": "bun@1.3.2"
}