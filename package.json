{
  "name": "typing-race",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"bun run --cwd apps/server dev\" \"bun run --cwd apps/web dev\"",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "bun run --cwd apps/server typecheck && bun run --cwd apps/web typecheck",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.3.2 <1.5.0"
  },
  "packageManager": "bun@1.3.2"
}